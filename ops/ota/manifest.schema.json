{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boviscan.local/schemas/ota-manifest.json",
  "title": "BoviScan OTA manifest",
  "type": "object",
  "required": ["schema_version", "product", "version", "channel", "created_at", "artifacts", "signatures"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "product": { "type": "string", "const": "boviscan" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].+)?$" },
    "channel": { "type": "string", "enum": ["stable", "beta", "dev"] },
    "created_at": { "type": "string", "format": "date-time" },
    "min_device_version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "sha256", "size"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "rollback": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "slot": { "type": "string", "enum": ["a", "b", "previous"] }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["alg", "key_id", "sig"],
        "properties": {
          "alg": { "type": "string", "enum": ["ed25519", "sigstore"] },
          "key_id": { "type": "string" },
          "sig": { "type": "string", "description": "base64 signature or sigstore bundle placeholder" }
        }
      }
    }
  },
  "additionalProperties": false
}
